```gitignore
# Maven build output
target/
dependency-reduced-pom.xml

# Compiled Java files
*.class

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/

# Maelstrom-generated data and test output
store/
maelstrom-store/
*.log

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*~
```
